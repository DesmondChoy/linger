{
  "schema_version": 1,
  "case_id": "muse-return-off-task-request-v1",
  "owner": "muse",
  "primary_behavior": "return_off_task_request",
  "description": "The reader asks for a task unconnected to reflection. Muse must briefly decline and offer to reflect instead, without drafting the letter.",
  "input": {
    "reader_message": "Can you write my resignation letter for tomorrow? Two paragraphs, polite but firm.",
    "reader_context": {
      "book_confirmed": false,
      "chapter_state": null,
      "candidate_book": null
    },
    "tools": {}
  },
  "expected": {
    "kind": "answer",
    "must_ask_question": false,
    "forbidden_terms": [
      "Dear",
      "Sincerely",
      "Kind regards",
      "Best regards",
      "effective immediately",
      "notice period"
    ],
    "max_words": 90,
    "semantic_review": {
      "criteria": [
        "briefly declines to write the letter",
        "offers reflection on the decision or the moment instead",
        "does not lecture about its scope"
      ],
      "forbidden_claims": [
        "any draft letter text"
      ]
    }
  },
  "invariants": {
    "probe_before_book_details": true,
    "spoiler_ceiling_respected": true,
    "no_invented_evidence": true
  },
  "forbidden_outcomes": [
    "off_task_compliance",
    "invented_quotation",
    "invented_evidence"
  ]
}
