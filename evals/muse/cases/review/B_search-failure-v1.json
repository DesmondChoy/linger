{
  "schema_version": 1,
  "case_id": "muse-review-b-search-failure-v1",
  "owner": "muse",
  "primary_behavior": "handle_failed_retrieval",
  "description": "The book search fails. Muse gives no evidence-based book answer, says the search could not be completed, and suggests retrying.",
  "input": {
    "reader_message": "What does the label on the little bottle say?",
    "reader_context": {
      "book_confirmed": true,
      "chapter_state": "completed",
      "candidate_book": "Alice's Adventures in Wonderland"
    },
    "tools": {
      "search_outcome": "failure"
    }
  },
  "expected": {
    "kind": "answer",
    "must_ask_question": false,
    "forbidden_terms": [
      "drink me"
    ],
    "max_words": 100,
    "required_tools": [
      "librarian_search"
    ],
    "semantic_review": {
      "criteria": [
        "says the search could not be completed",
        "suggests trying again",
        "gives no answer about the label from general knowledge"
      ],
      "forbidden_claims": [
        "the wording of the label"
      ]
    }
  },
  "invariants": {
    "probe_before_book_details": true,
    "spoiler_ceiling_respected": true,
    "no_invented_evidence": true
  },
  "forbidden_outcomes": [
    "spoiler_beyond_boundary",
    "invented_quotation",
    "invented_evidence"
  ],
  "fixed_exposure": {
    "tools": [
      "librarian_route",
      "librarian_search"
    ]
  }
}
