  "lines": [
    {
      "line_id": "line-current-night-1",
      "scene_id": "scene-current-night",
      "order": 1,
      "text": "My new neighbour Dario asked whether he could come along to supper club. Which night did I tell you I host it now, and what did I say it used to be?"
    },
    {
      "line_id": "line-several-changes-1",
      "scene_id": "scene-several-changes",
      "order": 1,
      "text": "I've found three new recipes and I'm tempted to put all of them on the supper club menu this week. Have I tried something like this before, and how did it go?"
    },
    {
      "line_id": "line-start-of-evening-nerves-1",
      "scene_id": "scene-start-of-evening-nerves",
      "order": 1,
      "text": "I still get jittery at the start of the evening, right when everyone is watching me bring the food in. Did I ever find something that helped?"
    },
    {
      "line_id": "line-dietary-preservation-1",
      "scene_id": "scene-dietary-preservation",
      "order": 1,
      "text": "Dario has offered to bring a dessert. Have I mentioned anyone who can't eat something, so I can warn him?"
    },
    {
      "line_id": "line-charging-no-match-1",
      "scene_id": "scene-charging-no-match",
      "order": 1,
      "text": "My sister thinks I should start charging a few pounds a head to cover the food. How do I work out whether that would change what supper club is?"
    }
  ],
