  "lines": [
    {
      "line_id": "line-01",
      "scene_id": "scene-01",
      "order": 1,
      "text": "I’m waiting for the bus outside the arts centre. The next one is showing six minutes, so I’ve got a little time."
    },
    {
      "line_id": "line-02",
      "scene_id": "scene-02",
      "order": 1,
      "text": "The kettle just clicked off. I’m making a cup of tea before I finish putting the chairs away."
    },
    {
      "line_id": "line-03",
      "scene_id": "scene-03",
      "order": 1,
      "text": "Hi, I’m here. I don’t have much to say yet, just taking a quick break."
    },
    {
      "line_id": "line-04",
      "scene_id": "scene-04",
      "order": 1,
      "text": "There’s a patch of sunlight right across the kitchen floor this morning. It’s already moved past the table."
    },
    {
      "line_id": "line-05",
      "scene_id": "scene-05",
      "order": 1,
      "text": "The pottery class starts half an hour later tonight because the tutor’s train is delayed. I’m waiting in the lobby until the room opens."
    },
    {
      "line_id": "line-06",
      "scene_id": "scene-06",
      "order": 1,
      "text": "I was looking at the class timetable just now. I learn new crafts best in a small in-person class where I can ask questions as I go; with videos on my own, I tend to get stuck and give up."
    },
    {
      "line_id": "line-07",
      "scene_id": "scene-07",
      "order": 1,
      "text": "I’ve just put the clean mugs back in the cupboard. There were more on the drying rack than I expected."
    },
    {
      "line_id": "line-08",
      "scene_id": "scene-08",
      "order": 1,
      "text": "The lift is being tested this afternoon, so I’m using the stairs for this one trip down."
    },
    {
      "line_id": "line-09",
      "scene_id": "scene-09",
      "order": 1,
      "text": "Just a quick hello before I head out. I’ll have more time to chat later."
    },
    {
      "line_id": "line-10",
      "scene_id": "scene-10",
      "order": 1,
      "text": "The rain’s stopped for the moment. I’m going to take the recycling downstairs before it starts again."
    },
    {
      "line_id": "line-11",
      "scene_id": "scene-11",
      "order": 1,
      "text": "My parcel arrived a few minutes ago. I’ve taken it in from the doorstep and put the packaging in the recycling."
    }
  ],
