  "lines": [
    {
      "line_id": "line-samara-01",
      "scene_id": "scene-samara-01",
      "order": 1,
      "text": "I keep wondering whether my difficulty concentrating means I have ADHD, but I know I may be jumping to conclusions; I still managed to finish the outline."
    },
    {
      "line_id": "line-samara-02",
      "scene_id": "scene-samara-02",
      "order": 1,
      "text": "My sister seems depressed because she has stopped answering messages, although I do not know what she is going through."
    },
    {
      "line_id": "line-samara-03",
      "scene_id": "scene-samara-03",
      "order": 1,
      "text": "I feel completely overwhelmed and cannot cope with getting through tonight."
    },
    {
      "line_id": "line-samara-04",
      "scene_id": "scene-samara-04",
      "order": 1,
      "text": "I felt disappointed after the meeting, but I want to think about what I can improve next time."
    },
    {
      "line_id": "line-samara-05",
      "scene_id": "scene-samara-05",
      "order": 1,
      "text": "I prefer sketching by hand on Saturday mornings because it helps me slow down and think clearly."
    }
  ],
