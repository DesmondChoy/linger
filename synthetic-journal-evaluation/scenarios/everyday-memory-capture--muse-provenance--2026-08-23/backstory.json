  "lines": [
    {
      "line_id": "line-mara-01",
      "scene_id": "scene-mara-01",
      "order": 1,
      "text": "I put the rice on, and I’m waiting for the timer before I head downstairs."
    },
    {
      "line_id": "line-mara-02",
      "scene_id": "scene-mara-02",
      "order": 1,
      "text": "Anyway, that’s all I had in mind just now."
    },
    {
      "line_id": "line-mara-03",
      "scene_id": "scene-mara-03",
      "order": 1,
      "text": "The clouds went pink for a minute after the rain."
    },
    {
      "line_id": "line-mara-04",
      "scene_id": "scene-mara-04",
      "order": 1,
      "text": "I’ll take the 6:20 train tonight and grab dinner after I get off."
    },
    {
      "line_id": "line-mara-05",
      "scene_id": "scene-mara-05",
      "order": 1,
      "text": "I watered the basil and folded the towels before logging on."
    },
    {
      "line_id": "line-mara-06",
      "scene_id": "scene-mara-06",
      "order": 1,
      "text": "Oh, I lost my train of thought—never mind."
    },
    {
      "line_id": "line-mara-07",
      "scene_id": "scene-mara-07",
      "order": 1,
      "text": "I’ve realized that sketching by hand helps me slow down and think clearly, so I want to keep Saturday mornings for it."
    },
    {
      "line_id": "line-mara-08",
      "scene_id": "scene-mara-08",
      "order": 1,
      "text": "The café downstairs has a long queue this afternoon."
    },
    {
      "line_id": "line-mara-09",
      "scene_id": "scene-mara-09",
      "order": 1,
      "text": "I left my tote by the front door for the market later."
    },
    {
      "line_id": "line-mara-10",
      "scene_id": "scene-mara-10",
      "order": 1,
      "text": "Lunch was noodles, cucumber, and a pear today."
    },
    {
      "line_id": "line-mara-11",
      "scene_id": "scene-mara-11",
      "order": 1,
      "text": "My desk feels oddly quiet with the fan switched off."
    }
  ],
  "offline_inputs": []
}
