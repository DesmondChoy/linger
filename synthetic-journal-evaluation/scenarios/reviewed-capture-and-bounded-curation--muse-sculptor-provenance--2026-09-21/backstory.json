  "lines": [
    {
      "line_id": "line-capture-01",
      "scene_id": "scene-capture-01",
      "order": 1,
      "text": "I put the lentils on the stove and will check them in ten minutes."
    },
    {
      "line_id": "line-capture-02",
      "scene_id": "scene-capture-02",
      "order": 1,
      "text": "I lost my train of thought for a moment, but it will come back."
    },
    {
      "line_id": "line-capture-03",
      "scene_id": "scene-capture-03",
      "order": 1,
      "text": "The clouds turned pink for a minute after the rain."
    },
    {
      "line_id": "line-capture-04",
      "scene_id": "scene-capture-04",
      "order": 1,
      "text": "I will take the 6:20 train tonight and pick up dinner afterward."
    },
    {
      "line_id": "line-capture-05",
      "scene_id": "scene-capture-05",
      "order": 1,
      "text": "I watered the basil and folded the towels before logging on."
    },
    {
      "line_id": "line-capture-06",
      "scene_id": "scene-capture-06",
      "order": 1,
      "text": "The hallway light flickered once and then stopped."
    },
    {
      "line_id": "line-capture-07",
      "scene_id": "scene-capture-07",
      "order": 1,
      "text": "I have realised that sketching by hand helps me slow down and think clearly, so I want to keep Saturday mornings for it."
    },
    {
      "line_id": "line-capture-08",
      "scene_id": "scene-capture-08",
      "order": 1,
      "text": "The cafe downstairs has a long queue this afternoon."
    },
    {
      "line_id": "line-capture-09",
      "scene_id": "scene-capture-09",
      "order": 1,
      "text": "I left my tote by the front door for the market later."
    },
    {
      "line_id": "line-capture-10",
      "scene_id": "scene-capture-10",
      "order": 1,
      "text": "Lunch was noodles, cucumber, and a pear today."
    },
    {
      "line_id": "line-capture-11",
      "scene_id": "scene-capture-11",
      "order": 1,
      "text": "My desk feels oddly quiet with the fan switched off."
    }
  ],
