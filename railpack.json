{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12",
    "node": "22",
    "pnpm": "10.34.6",
    "uv": "0.8.3"
  },
  "steps": {
    "build": {
      "commands": [
        "uv sync --locked --no-dev --no-editable",
        "pnpm --dir apps/frontend install --frozen-lockfile",
        "pnpm --dir apps/frontend build",
        "FASTEMBED_CACHE_PATH=/app/.cache/fastembed .venv/bin/python docker/cache_models.py"
      ]
    }
  },
  "deploy": {
    "startCommand": "uvicorn apps.backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1",
    "aptPackages": ["...", "libgomp1", "libstdc++6"],
    "variables": {
      "FASTEMBED_CACHE_PATH": "/app/.cache/fastembed",
      "HF_HUB_OFFLINE": "1",
      "LINGER_STATIC_DIR": "/app/apps/frontend/dist",
      "LINGER_STATE_DIR": "/var/lib/linger",
      "LINGER_MEMORY_DIR": "/var/lib/linger/memories"
    }
  }
}
