{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linger.local/data/synthetic-journals/input.schema.json",
  "title": "Synthetic journal persona input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "persona_id",
    "person_name",
    "background",
    "reading_list",
    "history_profile"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "persona_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "person_name": {"type": "string", "minLength": 1},
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demographics",
        "occupation",
        "life_context",
        "reading_habits",
        "voice_notes",
        "recurring_themes",
        "guardrails"
      ],
      "properties": {
        "demographics": {"type": "array", "items": {"type": "string"}},
        "occupation": {"type": "string"},
        "life_context": {"type": "array", "items": {"type": "string"}},
        "reading_habits": {"type": "array", "items": {"type": "string"}},
        "voice_notes": {"type": "array", "items": {"type": "string"}},
        "recurring_themes": {"type": "array", "items": {"type": "string"}},
        "guardrails": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reading_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["book_id", "book_version_id", "title", "author", "interest"],
        "properties": {
          "book_id": {"type": "string"},
          "book_version_id": {"type": "string"},
          "title": {"type": "string"},
          "author": {"type": "string"},
          "interest": {"type": "string"}
        }
      }
    },
    "history_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_date",
        "span_days",
        "entry_count",
        "generation_chunk_size",
        "position_expression",
        "media_frequency",
        "claim_style",
        "external_reference_density",
        "entry_length_mix",
        "entry_word_ranges",
        "planned_event_counts",
        "attachments"
      ],
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "span_days": {"type": "integer", "minimum": 1},
        "entry_count": {"type": "integer", "minimum": 6},
        "generation_chunk_size": {"type": "integer", "minimum": 2, "maximum": 6},
        "position_expression": {
          "enum": ["precise", "vague", "mixed", "usually_absent"]
        },
        "media_frequency": {"enum": ["none", "occasional", "frequent"]},
        "claim_style": {"enum": ["exploratory", "mixed", "assertive"]},
        "external_reference_density": {"enum": ["none", "low", "high"]},
        "entry_length_mix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["short", "medium", "long"],
          "properties": {
            "short": {"type": "integer", "minimum": 0},
            "medium": {"type": "integer", "minimum": 0},
            "long": {"type": "integer", "minimum": 0}
          }
        },
        "entry_word_ranges": {
          "type": "object",
          "additionalProperties": false,
          "required": ["short", "medium", "long"],
          "properties": {
            "short": {"$ref": "#/$defs/wordRange"},
            "medium": {"$ref": "#/$defs/wordRange"},
            "long": {"$ref": "#/$defs/wordRange"}
          }
        },
        "planned_event_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "durable_reflections",
            "explicit_preferences_or_intentions",
            "concrete_incidents",
            "later_updates",
            "unrelated_notes",
            "transient_notes",
            "sensitive_speculations",
            "corrections",
            "deletion_requests",
            "near_duplicates",
            "reconnect_queries"
          ],
          "properties": {
            "durable_reflections": {"type": "integer", "minimum": 0},
            "explicit_preferences_or_intentions": {"type": "integer", "minimum": 0},
            "concrete_incidents": {"type": "integer", "minimum": 0},
            "later_updates": {"type": "integer", "minimum": 0},
            "unrelated_notes": {"type": "integer", "minimum": 0},
            "transient_notes": {"type": "integer", "minimum": 0},
            "sensitive_speculations": {"type": "integer", "minimum": 0},
            "corrections": {"type": "integer", "minimum": 0},
            "deletion_requests": {"type": "integer", "minimum": 0},
            "near_duplicates": {"type": "integer", "minimum": 0},
            "reconnect_queries": {"type": "integer", "minimum": 0}
          }
        },
        "attachments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_kinds", "target_count", "description_rules"],
          "properties": {
            "allowed_kinds": {
              "type": "array",
              "items": {"enum": ["image"]},
              "uniqueItems": true
            },
            "target_count": {"type": "integer", "minimum": 0},
            "description_rules": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  },
  "$defs": {
    "wordRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_words", "max_words"],
      "properties": {
        "min_words": {"type": "integer", "minimum": 1},
        "max_words": {"type": "integer", "minimum": 1}
      }
    }
  }
}
