.DS_Store
.venv/

# Secrets — `.env.example` stays tracked
.env
.env.local
data/gutenberg/pg*.txt
data/gutenberg/pg*.metadata.json

# Canonical, reviewable corpus artifacts are part of the repository.
!data/
!data/corpus/
!data/corpus/**

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Miscellaneous
tmp/
__pycache__/
