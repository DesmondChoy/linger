# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
#   cp -f .env.example .env

# --- Model provider -------------------------------------------------------
# Set the key for the provider selected by LINGER_MODEL. The other keys may
# remain empty.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional public-web search. Serendipity needs both this key and
# LINGER_WEB_SEARCH_ENABLED=true. Sculptor's offline retrieval-research command
# uses this key separately, after owner approval of its research input.
EXA_API_KEY=
LINGER_WEB_SEARCH_ENABLED=false

# Model the chat agent runs on. Supported prefixes: google, openai, anthropic.
LINGER_MODEL=openai:gpt-6-luna
# Optional per-role overrides, as JSON. Roles: muse, librarian, serendipity,
# provenance, sculptor. A role without an entry uses LINGER_MODEL.
# LINGER_ROLE_MODELS={"serendipity": "openai:gpt-5.6-luna"}
# OpenAI reasoning effort per role: minimal, low, medium, or high.
# LINGER_ROLE_REASONING={"serendipity": "medium"}

# --- Backend --------------------------------------------------------------
# Browser origins allowed to call the API. Comma-separated.
# 5173 is the Vite dev server default.
LINGER_ALLOWED_ORIGINS=http://localhost:5173

# Optional runtime storage locations. Docker Compose sets these to named
# volumes; local development defaults to data/ and memories/ in this repository.
# LINGER_STATE_DIR=/path/to/state
# LINGER_MEMORY_DIR=/path/to/memories

# Optional built frontend directory. The release image sets /app/static.
# LINGER_STATIC_DIR=

# --- Telemetry (optional) -------------------------------------------------
# Local development uses credentials created by `logfire projects use`.
# Set a Logfire write token here only for deployed or CI environments.
# LOGFIRE_TOKEN=

# Developer/demo only: show each turn's full content trace (agent prompts,
# tool calls, outputs, Serendipity searches, memory text) in Inspect.
# Never enable for a deployment real readers use.
LINGER_DEV_INSPECT=false
