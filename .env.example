# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env

# --- Model provider -------------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey
# Read by the backend and passed to PydanticAI's GoogleProvider.
GOOGLE_API_KEY=

# Model the chat agent runs on. Must carry the `google:` provider prefix.
# Alternatives: google:gemini-2.5-pro (stronger, slower),
#               google:gemini-2.5-flash-lite (cheapest),
#               google:gemini-3.6-flash (newest flash in pydantic-ai 2.26)
LINGER_MODEL=google:gemini-2.5-flash

# --- Backend --------------------------------------------------------------
# Browser origins allowed to call the API. Comma-separated.
# 5173 is the Vite dev server default.
LINGER_ALLOWED_ORIGINS=http://localhost:5173

# --- Telemetry (optional) -------------------------------------------------
# Leave unset to disable tracing. Set to a Logfire write token to send
# PydanticAI agent traces to https://logfire.pydantic.dev
# LOGFIRE_TOKEN=
