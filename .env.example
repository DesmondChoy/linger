# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env

# --- Model provider -------------------------------------------------------
# Set the key for the provider selected by LINGER_MODEL. The other keys may
# remain empty.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model the chat agent runs on. Supported prefixes: google, openai, anthropic.
LINGER_MODEL=google:gemini-2.5-flash

# --- Backend --------------------------------------------------------------
# Browser origins allowed to call the API. Comma-separated.
# 5173 is the Vite dev server default.
LINGER_ALLOWED_ORIGINS=http://localhost:5173

# Server-owned identity for this single-user prototype. Browser requests never
# supply or override the account that owns memories.
LINGER_ACCOUNT_ID=local-prototype-user

# --- Telemetry (optional) -------------------------------------------------
# Tracing is always on and always local: spans are created whether or not this
# is set, so the trace path stays exercised in development. Setting a Logfire
# write token additionally ships them to https://logfire.pydantic.dev
#
# Spans never carry chat content. Per specification.md section 8.1 they exclude
# user and assistant messages, book excerpts, and personal memories; see
# apps/backend/telemetry.py for the exact allowlist of what is recorded.
# LOGFIRE_TOKEN=
