# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env

# --- Model provider -------------------------------------------------------
# Read by the backend and passed to PydanticAI's provider.
API_KEY=

# Model the chat agent runs on. Must carry the provider prefix, e.g. `google:...`.
LINGER_MODEL=google:gemini-2.5-flash

# --- Backend --------------------------------------------------------------
# Browser origins allowed to call the API. Comma-separated.
# 5173 is the Vite dev server default.
LINGER_ALLOWED_ORIGINS=http://localhost:5173

# --- Telemetry (optional) -------------------------------------------------
# Leave unset to disable tracing. Set to a Logfire write token to send
# PydanticAI agent traces to https://logfire.pydantic.dev
# LOGFIRE_TOKEN=
